import streamlit as st

# إخفاء العناصر الافتراضية لتحسين شكل المنصة
hide_streamlit_style = """
<style>
#MainMenu {visibility: hidden;}
footer {visibility: hidden;}
header {visibility: hidden;}
</style>
"""
st.markdown(hide_streamlit_style, unsafe_allow_html=True)

# إعدادات الصفحة الأساسية
st.set_page_config(
    page_title="Memo Platform",
    page_icon="⚡",
    layout="wide"
)

# عنوان المنصة
st.title("⚡ Memo AI Assistant")
st.write("أهلاً بك يا محمد! منصتك الذكية جاهزة لمساعدتك في أي وقت.")

# تهيئة سجل المحادثة
if "chat_history" not in st.session_state:
    st.session_state.chat_history = [
        {"role": "assistant", "content": "أهلاً بك يا محمد! أنا ميمو، مساعدك الذكي. اسألني أي سؤال أو اطلب مني أي كود برمجي وسأقوم بتفيذه فوراً."}
    ]

# عرض رسائل الشات السابقة
for message in st.session_state.chat_history:
    with st.chat_message(message["role"]):
        st.markdown(message["content"])

# استقبال السؤال أو الأمر من مستخدم المنصة
if user_question := st.chat_input("اكتب سؤالك أو الكود المطلوب هنا..."):
    
    # حفظ وعرض رسالة المستخدم
    st.session_state.chat_history.append({"role": "user", "content": user_question})
    with st.chat_message("user"):
        st.markdown(user_question)

    # معالجة الرد من ميمو
    with st.chat_message("assistant"):
        q = user_question.lower()
        if "كود" in q or "بايثون" in q or "python" in q:
            bot_reply = """تفضل كود بايثون جاهز ومنظم للعمل:
```python
# برنامج بسيط لحساب مجموع الأرقام
numbers_list = [5, 10, 15, 20]
total = sum(numbers_list)
print("المجموع الكلي هو:", total)
```"""
        elif "ازيك" in q or "عامل ايه" in q or "سلام عليكم" in q:
            bot_reply = "وعليكم السلام يا غالي! الحمد لله كله تمام، جاهز لنكتب ونطور أحلى تطبيقات مع بعض."
        elif "اسمك" in q:
            bot_reply = "أنا ميمو (Memo AI)، المساعد الشخصي الذكي الخاص بمنصة محمد أدل."
        else:
            bot_reply = f"استلمت سؤالك بخصوص ({user_question}): المنصة شغال بكفاءة ومستعد لأي تعديل أو كود برمجي إضافي تحتاجه حالاً!"
        
        st.markdown(bot_reply)

    # حفظ رد المساعد في الذاكرة
    st.session_state.chat_history.append({"role": "assistant", "content": bot_reply})
